{/* Browser runtime for marimo islands in .mdx pages: registers the
    <marimo-mdx-island> custom element and boots Pyodide. MarkdownContent.astro
    renders it on every page with marimo cells, so pages need no import.
    The matching styles load globally via Starlight customCss.
    Started as bedrock-web's copy; adds the __resizeIframe helper below and
    styles the pill with utilities.

    The status pill below is ours, not marimo's: the islands runtime
    shows nothing while Pyodide boots (its own toast only appears when
    the user interacts too early). The pill is server-rendered so it
    shows from the first paint, and hides itself without JavaScript
    (noscript:hidden). Each <marimo-island> mirrors its cell's runtime
    status as a data-status attribute; the script below copies that onto
    the pill as data-busy and data-done, which its utilities react to. */}

<script is:inline>
// marimo's `mo.iframe` output calls a global `__resizeIframe(this)` when the frame
// loads, to grow the frame to its content. marimo's own app page defines that
// helper; the islands runtime these docs use does not, so the call fails and the
// frame keeps whatever height the site's CSS gives it (Starlight sets iframes to
// `height: auto`, which is 150px). This is the same helper, loaded before islands mount.
window.__resizeIframe ??= (frame) => {
  const fit = () => {
    const root = frame.contentDocument?.documentElement;
    if (!root || root.scrollHeight === root.clientHeight) return;
    const scrollbar = root.scrollWidth > root.clientWidth ? 20 : 0;
    frame.style.height = `${root.scrollHeight + scrollbar}px`;
  };
  fit();
  const body = frame.contentDocument?.body;
  if (body) new ResizeObserver(fit).observe(body);
};
</script>


<div
  id="marimo-boot-status"
  role="status"
  aria-live="polite"
  class="group mt-4 inline-flex items-center gap-2 rounded-full border border-doc-border bg-doc-nav px-3.5 py-1.5 text-sm text-doc-muted transition-opacity duration-400 noscript:hidden data-done:pointer-events-none data-done:opacity-0"
>
  <span
    class="size-3.5 flex-none animate-spin rounded-full border-2 border-doc-border border-t-doc-accent-text motion-reduce:animate-none"
    aria-hidden="true"
  ></span>
  <span class="group-data-busy:hidden">Loading the Python runtime…</span>
  <span class="hidden group-data-busy:inline">Running the notebook cells…</span>
</div>

<script>
  import "@marimo-team/mdx-marimo/element/auto";

  // Mirror the cells' state on the pill: data-busy while any cell is queued
  // or running (swaps the label), data-done once a cell errors or every cell
  // has run (fades the pill out). "Has run" needs memory: the status is
  // "idle" both during the whole Pyodide boot and after the first run, so
  // latch on the first queued/running status and dismiss for good once every
  // island is idle again (after a beat, so the gap between two cells' runs
  // doesn't dismiss early).
  const pill = document.getElementById("marimo-boot-status");
  if (pill) {
    let sawActivity = false;
    const observer = new MutationObserver(() => {
      const statuses = Array.from(
        document.querySelectorAll("marimo-island"),
      ).map((island) => island.getAttribute("data-status"));
      const busy = statuses.some((s) => s === "queued" || s === "running");
      pill.toggleAttribute("data-busy", busy);
      if (document.querySelector(".marimo-island-error")) {
        pill.setAttribute("data-done", "");
      }
      sawActivity ||= busy;
      if (sawActivity && !busy) {
        window.setTimeout(() => {
          const stillBusy = Array.from(
            document.querySelectorAll("marimo-island"),
          ).some((island) =>
            ["queued", "running"].includes(
              island.getAttribute("data-status") ?? "",
            ),
          );
          if (stillBusy) return;
          observer.disconnect();
          pill.setAttribute("data-done", "");
          window.setTimeout(() => pill.remove(), 500);
        }, 600);
      }
    });
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["data-status"],
    });
  }
</script>
