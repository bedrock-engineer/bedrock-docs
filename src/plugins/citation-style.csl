<?xml version="1.0" encoding="utf-8"?>
<!-- How the docs cite. A standard is cited by its number and year, the way
     engineers name it: (EN 1997-1:2004, 1.5.2.4). Anything else is cited by
     author and year: (Robertson 2016, p. 12). -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>Bedrock.engineer docs</title>
    <id>https://bedrock-engineer.github.io/bedrock-docs/citation-style</id>
    <category citation-format="author-date"/>
    <updated>2026-11-15T00:00:00+00:00</updated>
  </info>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="standard-label">
    <group delimiter=":">
      <text variable="number"/>
      <text macro="year"/>
    </group>
  </macro>
  <macro name="citation-label">
    <choose>
      <if type="standard">
        <text macro="standard-label"/>
      </if>
      <else>
        <group delimiter=" ">
          <names variable="author">
            <name form="short" and="symbol" delimiter=", " et-al-min="3" et-al-use-first="1"/>
            <substitute>
              <names variable="editor"/>
              <text variable="title"/>
            </substitute>
          </names>
          <text macro="year"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="locator">
    <!-- A bare locator is parsed as a page; for a standard it is a clause, so it
         shows without a label: (EN 1997-1:2004, 2.4.1). A named one keeps its
         label: [@key, section 6] gives (EN 1997-1:2004, section 6). -->
    <choose>
      <if type="standard" locator="page" match="all">
        <text variable="locator"/>
      </if>
      <else-if type="standard">
        <group delimiter=" ">
          <label variable="locator" form="long"/>
          <text variable="locator"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="sort-key">
    <choose>
      <if type="standard">
        <text variable="number"/>
      </if>
      <else>
        <names variable="author">
          <name name-as-sort-order="all"/>
        </names>
      </else>
    </choose>
  </macro>
  <citation disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="citation-label"/>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="sort-key"/>
      <key macro="year"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="standard">
          <group delimiter=". ">
            <text macro="standard-label"/>
            <text variable="title"/>
            <text variable="publisher"/>
          </group>
        </if>
        <else>
          <group delimiter=". ">
            <group delimiter=" ">
              <names variable="author">
                <name name-as-sort-order="all" initialize-with=". " delimiter=", " and="symbol"/>
                <substitute>
                  <names variable="editor"/>
                </substitute>
              </names>
              <text macro="year" prefix="(" suffix=")"/>
            </group>
            <text variable="title"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
            </group>
            <text variable="publisher"/>
            <text variable="DOI" prefix="https://doi.org/"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
